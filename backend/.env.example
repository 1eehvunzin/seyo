# Copy to .env and fill in. Everything has a dev default; see ../INTEGRATIONS.md for what each one needs.
ENV=dev
DATABASE_URL=sqlite:///./seyo.db
JWT_SECRET=

APPLE_BUNDLE_ID=com.seyo.app
KAKAO_APP_ID=

DEV_LOGIN=true
DEV_BILLING=true

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

FREE_PAGES=5
FREE_AI_EDITS_PER_DAY=20

PUBLIC_BASE_URL=http://localhost:8000
APP_SCHEME=seyo
APP_STORE_URL=https://apps.apple.com/app/id0000000000

APPLE_APP_ID=
APPLE_ROOT_CERT_DIR=

EXPO_ACCESS_TOKEN=
REMINDER_HOUR_KST=21

CORS_ORIGINS=*
