# Copy to .env and fill in. Everything has a dev default; see ../INTEGRATIONS.md for what each one needs.
ENV=dev
DATABASE_URL=sqlite:///./seyo.db
JWT_SECRET=

APPLE_BUNDLE_ID=com.seyo.app
KAKAO_APP_ID=

DEV_LOGIN=true
DEV_BILLING=true

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

FREE_PAGES=5
# 말로 고치기는 작은 모델로 (1회 ≈ ₩4)
OPENAI_EDIT_MODEL=gpt-5-mini
OPENAI_EDIT_REASONING=low
CLAUDE_EDIT_MODEL=claude-haiku-5-5
# AI 횟수 (새 페이지 + 고치기, 한국 시간 기준 달)
FREE_AI_EDITS_PER_MONTH=30
PLUS_AI_EDITS_PER_MONTH=300
# 온보딩 체험 (로그인 전): 설치당 평생, IP당 하루
GUEST_AI_EDITS=5
GUEST_AI_EDITS_PER_IP_PER_DAY=40

PUBLIC_BASE_URL=http://localhost:8000
APP_SCHEME=seyo
APP_STORE_URL=https://apps.apple.com/app/id0000000000

APPLE_APP_ID=
APPLE_ROOT_CERT_DIR=

EXPO_ACCESS_TOKEN=
REMINDER_HOUR_KST=21

CORS_ORIGINS=*
# OpenAI-compatible gateway instead of OpenAI itself (e.g. https://apirouter.pleum.ai/v1)
OPENAI_BASE_URL=
